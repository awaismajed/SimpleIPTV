<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0B1520">

    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent"
        android:layout_height="48dp" android:gravity="center_vertical"
        android:paddingHorizontal="12dp" android:background="#0E1925">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Simple IPTV 4.0"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
        <Button android:id="@+id/addPlaylistButton"
            android:layout_width="52dp" android:layout_height="44dp"
            android:text="+ M3U" android:textSize="10sp" android:textAllCaps="false"
            android:contentDescription="Add custom M3U playlist"/>
        <Button android:id="@+id/refreshButton"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="↻" android:textSize="19sp"
            android:contentDescription="Refresh current playlist"/>
        <androidx.mediarouter.app.MediaRouteButton android:id="@+id/castButton"
            android:layout_width="48dp" android:layout_height="48dp"
            app:mediaRouteButtonTint="@android:color/white"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/contentArea" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">

        <LinearLayout android:id="@+id/videoPane" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <androidx.media3.ui.PlayerView android:id="@+id/playerView"
                android:layout_width="match_parent" android:layout_height="190dp"
                android:background="#000000" android:keepScreenOn="true" app:resize_mode="fit"/>
            <LinearLayout android:id="@+id/playbackControls"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="#0E1925" android:paddingHorizontal="4dp">
                <Button android:id="@+id/previousButton" android:layout_width="0dp"
                    android:layout_height="44dp" android:layout_weight="1" android:text="◀"/>
                <Button android:id="@+id/favoriteButton" android:layout_width="0dp"
                    android:layout_height="44dp" android:layout_weight="1.7"
                    android:text="☆ Favorite" android:textSize="12sp" android:textAllCaps="false"/>
                <Button android:id="@+id/nextButton" android:layout_width="0dp"
                    android:layout_height="44dp" android:layout_weight="1" android:text="▶"/>
                <Button android:id="@+id/fullscreenButton" android:layout_width="0dp"
                    android:layout_height="44dp" android:layout_weight="1" android:text="⛶"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/browserPane" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:id="@+id/filterPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingHorizontal="8dp" android:paddingTop="5dp" android:paddingBottom="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:layout_marginEnd="4dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="CHANNEL" android:textColor="#AFC4D7" android:textSize="10sp"/>
                        <Spinner android:id="@+id/channelFilter" android:layout_width="match_parent"
                            android:layout_height="44dp" android:background="@drawable/filter_dropdown"
                            android:paddingHorizontal="10dp" android:spinnerMode="dropdown"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:layout_marginStart="4dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="AVAILABILITY" android:textColor="#AFC4D7" android:textSize="10sp"/>
                        <Spinner android:id="@+id/availabilityFilter" android:layout_width="match_parent"
                            android:layout_height="44dp" android:background="@drawable/filter_dropdown"
                            android:paddingHorizontal="10dp" android:spinnerMode="dropdown"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:baselineAligned="false"
                    android:layout_marginTop="4dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:layout_marginEnd="4dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="CATEGORY" android:textColor="#AFC4D7" android:textSize="10sp"/>
                        <Spinner android:id="@+id/categoryFilter" android:layout_width="match_parent"
                            android:layout_height="44dp" android:background="@drawable/filter_dropdown"
                            android:paddingHorizontal="10dp" android:spinnerMode="dropdown"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:layout_marginStart="4dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="COUNTRY" android:textColor="#AFC4D7" android:textSize="10sp"/>
                        <Spinner android:id="@+id/countryFilter" android:layout_width="match_parent"
                            android:layout_height="44dp" android:background="@drawable/filter_dropdown"
                            android:paddingHorizontal="10dp" android:spinnerMode="dropdown"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <EditText android:id="@+id/searchBox" android:layout_width="0dp"
                        android:layout_height="44dp" android:layout_weight="1"
                        android:hint="Search channels…" android:singleLine="true"
                        android:paddingHorizontal="12dp" android:textColor="#FFFFFF"
                        android:textColorHint="#AFC4D7" android:background="#172638"/>
                    <Button android:id="@+id/scanButton" android:layout_width="76dp"
                        android:layout_height="44dp" android:layout_marginStart="6dp"
                        android:text="Scan" android:textSize="12sp" android:textAllCaps="false"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent"
                android:layout_height="28dp" android:gravity="center_vertical"
                android:paddingHorizontal="12dp" android:singleLine="true"
                android:ellipsize="end" android:text="Loading channels..."
                android:textColor="#C4D0DC" android:textSize="12sp"/>
            <LinearLayout android:id="@+id/scanSummary" android:layout_width="match_parent"
                android:layout_height="36dp" android:orientation="horizontal"
                android:visibility="gone" android:paddingHorizontal="6dp">
                <TextView android:id="@+id/workingCount" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:gravity="center" android:text="✓ 0 Working" android:textColor="#54D892" android:textSize="11sp"/>
                <TextView android:id="@+id/notWorkingCount" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:gravity="center" android:text="✕ 0 Offline" android:textColor="#FF6B6B" android:textSize="11sp"/>
                <TextView android:id="@+id/uncertainCount" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:gravity="center" android:text="Uncertain 0" android:textColor="#C7D0DA" android:textSize="11sp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/channelList"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent"
                android:layout_height="50dp" android:orientation="horizontal"
                android:gravity="center" android:background="#0E1925" android:paddingHorizontal="4dp">
                <Button android:id="@+id/channelsTab" android:layout_width="0dp"
                    android:layout_height="46dp" android:layout_weight="1"
                    android:text="Channels" android:textSize="12sp" android:textAllCaps="false"/>
                <Button android:id="@+id/favoritesTab" android:layout_width="0dp"
                    android:layout_height="46dp" android:layout_weight="1"
                    android:text="★ Favorites" android:textSize="12sp" android:textAllCaps="false"/>
                <Button android:id="@+id/scanTab" android:layout_width="0dp"
                    android:layout_height="46dp" android:layout_weight="1"
                    android:text="Scan" android:textSize="12sp" android:textAllCaps="false"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>