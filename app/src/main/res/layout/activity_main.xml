<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0B1520">

    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent"
        android:layout_height="48dp" android:gravity="center_vertical"
        android:paddingHorizontal="12dp" android:background="#0E1925">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="SimpleIPTV"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
        <androidx.mediarouter.app.MediaRouteButton android:id="@+id/castButton"
            android:layout_width="48dp" android:layout_height="48dp"
            app:mediaRouteButtonTint="@android:color/white"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/contentArea" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">

        <LinearLayout android:id="@+id/videoPane" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <androidx.media3.ui.PlayerView android:id="@+id/playerView"
                android:layout_width="match_parent" android:layout_height="190dp"
                android:background="#000000" android:keepScreenOn="true" app:resize_mode="fit"/>
            <TextView android:id="@+id/nowPlaying" android:layout_width="match_parent"
                android:layout_height="34dp" android:gravity="center_vertical"
                android:paddingHorizontal="14dp" android:background="#122C42"
                android:text="Select a channel to play" android:textColor="#FFFFFF"
                android:textStyle="bold" android:textSize="13sp"
                android:singleLine="true" android:ellipsize="marquee"
                android:selected="true"/>
            <LinearLayout android:id="@+id/playbackControls"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="#0E1925" android:paddingHorizontal="8dp">
                <Button android:id="@+id/previousButton" android:layout_width="0dp"
                    android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/player_control_button" android:textColor="#FFFFFF" android:textSize="22sp" android:textAllCaps="false" android:contentDescription="Previous channel" android:text="◀"/>
                <Button android:id="@+id/nextButton" android:layout_width="0dp"
                    android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/player_control_button" android:textColor="#FFFFFF" android:textSize="22sp" android:textAllCaps="false" android:contentDescription="Next channel" android:text="▶"/>
                <Button android:id="@+id/fullscreenButton" android:layout_width="0dp"
                    android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/player_control_button" android:textColor="#FFFFFF" android:textSize="22sp" android:textAllCaps="false" android:contentDescription="Change orientation" android:text="⛶"/>
                <Button android:id="@+id/settingsButton" android:layout_width="0dp"
                    android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/player_control_button" android:textColor="#FFFFFF" android:textSize="22sp" android:textAllCaps="false" android:contentDescription="Open settings"
                    android:text="⚙"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/browserPane" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:id="@+id/filterPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingHorizontal="10dp" android:paddingVertical="5dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="BROWSE CHANNELS" android:textColor="#AFC4D7" android:textSize="11sp"/>
                <Spinner android:id="@+id/channelFilter" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/filter_dropdown"
                    android:paddingHorizontal="12dp" android:spinnerMode="dropdown"/>
                <EditText android:id="@+id/searchBox" android:layout_width="match_parent"
                    android:layout_height="46dp" android:layout_marginTop="6dp"
                    android:hint="Search channels…" android:singleLine="true"
                    android:paddingHorizontal="12dp" android:textColor="#FFFFFF"
                    android:textColorHint="#AFC4D7" android:background="#172638"/>
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent"
                android:layout_height="28dp" android:gravity="center_vertical"
                android:paddingHorizontal="12dp" android:singleLine="true"
                android:ellipsize="end" android:text="Loading channels..."
                android:textColor="#C4D0DC" android:textSize="12sp"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/channelList"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:id="@+id/settingsPage" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:visibility="gone" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <Button android:id="@+id/backFromSettings" android:layout_width="wrap_content"
                android:layout_height="48dp" android:text="← Back to channels"
                android:textAllCaps="false"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Settings" android:textColor="#FFFFFF"
                android:textSize="26sp" android:textStyle="bold" android:paddingVertical="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PLAYLIST MANAGEMENT" android:textColor="#AFC4D7" android:textSize="12sp"/>
            <Button android:id="@+id/addPlaylistButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:text="+ Add M3U playlist URL" android:textAllCaps="false"/>
            <Button android:id="@+id/refreshButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:text="↻ Refresh current playlist" android:textAllCaps="false"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CHANNEL AVAILABILITY" android:textColor="#AFC4D7"
                android:textSize="12sp" android:paddingTop="18dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Scan all configured playlists, including custom sources. Every unique channel URL is checked again. Results are saved, and working channels appear in the browser."
                android:textColor="#DDE7F0" android:textSize="14sp" android:paddingVertical="8dp"/>
            <Button android:id="@+id/scanButton" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="Scan all channels"
                android:textAllCaps="false"/>
            <TextView android:id="@+id/settingsScanStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="No scan running"
                android:textColor="#AFC4D7" android:textSize="13sp" android:paddingVertical="10dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>